# Copy to .env and fill in (NEVER commit .env):
#   cp .env.example .env

# Required — OpenAI direct (sk-proj-...) or OpenRouter (sk-or-...)
OPENAI_API_KEY=sk-your-key-here

# Controlled / paper default: direct OpenAI Turbo
GENERATION_MODEL=gpt-4-turbo
MODEL=gpt-4-turbo
CONTROLLED_MODEL=gpt-4-turbo
USE_OPENROUTER=0

# Optional OpenRouter:
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# USE_OPENROUTER=1
# GENERATION_MODEL=openai/gpt-4-turbo
